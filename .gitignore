# Trained model checkpoints — too large for GitHub (100MB limit).
# Backed up to s3://segmentation-model-gv/checkpoints/ ; see src/segmentation/MODEL_MANIFEST.md
src/segmentation/unet_summer_model_unfrozen_100

# Committed reference data for the analysis notebooks. The blanket *.csv rule
# above exists to keep the multi-hundred-MB metadata dumps out; these four are
# small, and areas_true_vs_predicted_final.ipynb needs them.
!data/analysis/*.csv
!data/glims_18k.parquet

# A 32-pair training fixture, committed so `glacierview train` can be smoke
# tested without the full 9.3 GB set.
!data/sample/**

# figures/ is curated project artwork — diagrams, the architecture figure, the
# UTM illustrations, paper plots. The blanket *.png / *.jpg rules above target
# generated model output, not these. Un-ignore by extension rather than with
# !figures/** so that .DS_Store stays ignored.
!figures/*.png
!figures/*.jpg
!figures/*.drawio
!figures/*.pgw
!figures/inventory-examples/*.png
